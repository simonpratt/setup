function certview () {
  nslookup $1
  openssl s_client -showcerts -servername $1 -connect $1:443 <<< "Q"
}

function certview-debug () {
  nslookup $1
  (openssl s_client -showcerts -servername $1 -connect $1:443 <<< "Q" | openssl x509 -text | grep -iA2 "Validity")
}

rm_modules() {
  local -a targets
  targets=("${(@f)$(find . -type d -name node_modules -prune 2>/dev/null)}")
  targets=(${targets:#})   # drop empty entries

  if (( ${#targets} == 0 )); then
    print "No node_modules directories found under $PWD"
    return 0
  fi

  print -l $targets
  print "\n${#targets} directories, $(du -shc $targets 2>/dev/null | tail -1 | cut -f1) total"

  read -q "?Delete these? [y/N] " || { print "\nAborted."; return 1 }
  print
  rm -rf $targets
  print "Done."
}

# Lists skills registered with `sbx skills ls` that no longer exist in ~/.claude/skills/,
# then offers to prune them from sbx.
prune-sbx() {
  emulate -L zsh
  local skills_dir="$HOME/.agents/skills"
  local ls_output answer skill
  local -a sbx_skills local_skills stale_skills failed_skills

  ls_output="$(sbx skills ls)" || {
    print -u2 "prune-sbx: 'sbx skills ls' failed"
    return 1
  }

  # First column of `sbx skills ls`, minus the SKILL/STORE header row (deduplicated).
  sbx_skills=(${(fu)$(print -r -- "$ls_output" | awk 'NR > 1 && NF { print $1 }')})
  # Entries in the skills dir (basename only; empty if the dir is missing).
  local_skills=($skills_dir/*(N:t))

  # Items in sbx_skills that are not in local_skills.
  stale_skills=(${sbx_skills:|local_skills})

  if (( ! $#stale_skills )); then
    print "All sbx skills are present in $skills_dir. Nothing to prune."
    return 0
  fi

  print "Skills in sbx but missing from $skills_dir (prune these):"
  printf '  %s\n' $stale_skills

  read -r "answer?Prune all of them from sbx? [y/N] "
  if [[ $answer != [Yy] ]]; then
    print "Nothing pruned."
    return 0
  fi

  for skill in $stale_skills; do
    print "Pruning $skill..."
    sbx skills rm "$skill" --force || failed_skills+=("$skill")
  done

  if (( $#failed_skills )); then
    print -u2 "Failed to prune: ${failed_skills[*]}"
    return 1
  fi
  print "Done."
}

docker-log() {
  if command -v pino-pretty &> /dev/null; then
    docker logs --tail 1000 -f "$1" | pino-pretty
  else
    docker logs --tail 1000 -f "$1"
  fi
}

k-ns() {
  kubectl config set-context --current --namespace=$1
}

ack-ssm-env() {
  params=$(aws ssm get-parameters-by-path --with-decryption --recursive --path $1 | jq -r '.Parameters[] | (.Name + " " + .Value)' | sort -u)
  if [ -z "$2" ]
    then
      echo "filtering none"
      echo $params
  else
    echo "filtering $2"
    echo $params | ack $2
  fi
}

sha1check() {
    # Set the directory to check (default to current directory if no argument provided)
    if [ $# -eq 0 ]; then
        local DIR="."
    else
        local DIR="$1"
    fi

    # Check if directory exists
    if [ ! -d "$DIR" ]; then
        echo "Error: Directory '$DIR' does not exist."
        return 1
    fi

    echo "==================================================="
    echo "SHA-1 Checksums for files in: $(realpath "$DIR")"
    echo "==================================================="
    echo

    # Find all files (not directories) and calculate SHA-1 checksums
    find "$DIR" -type f -print0 | while IFS= read -r -d '' file; do
        # Calculate SHA-1 checksum
        checksum=$(shasum -a 1 "$file" 2>/dev/null)
        
        if [ $? -eq 0 ]; then
            # Extract just the hash part
            hash=$(echo "$checksum" | cut -d' ' -f1)
            # Get relative path for cleaner output
            rel_path=$(realpath --relative-to="$DIR" "$file" 2>/dev/null || echo "$file")
            
            # Format output nicely
            printf "%-40s  %s\n" "$hash" "$rel_path"
        else
            echo "Error calculating checksum for: $file"
        fi
    done | sort -k2  # Sort by filename

    echo
    echo "==================================================="
    echo "Checksum calculation complete."
}

alias pretty="grep '^{' | jq"
 
alias dirstat="du -h -d 1 | sort -rh"
 
# Tail pod logs with stern and pretty-print them with pino-pretty.
# Usage: slogs <pod-query> [extra stern args...]
slogs() {
  if (( $# < 1 )); then
    print -u2 "usage: slogs <pod-query> [extra stern args...]"
    return 1
  fi
  local query="$1"; shift

  stern "$query" --exclude-container=istio-proxy -e healthz -o raw "$@" \
    | pino-pretty \
        --translateTime 'HH:MM:ss.l' \
        --ignore 'pid,v,hostname,startAt,sc,referer,userAgent,ip,originIp,authSegment,statusMessage,url,status,method,timeMilliseconds,retries' \
        --messageFormat '{msg} {if method}{method} {end}{url} {if status}-> {status} {end}{if timeMilliseconds}({timeMilliseconds}ms){end}'
}

# Interactive git branch selector
glrr() {
  emulate -L zsh
  local -a branches
  branches=(${(f)$(git for-each-ref --sort=-committerdate --count=10 \
    --format='%(refname:short)' refs/heads/ 2>/dev/null)})

  if (( ! $#branches )); then
    print -u2 "glrr: no branches found (not in a git repo?)"
    return 1
  fi

  local total=$#branches selected=1 key rest mark i
  local current=$(git branch --show-current)

  printf '\e[?1049h\e[?25l'   # alternate screen, hide cursor
  {
    while true; do
      printf '\e[H\e[J'
      print "Select a branch (↑/↓ or j/k, Enter to select, q/Esc to quit):\n"
      for i in {1..$total}; do
        mark=' '; [[ ${branches[i]} == $current ]] && mark='*'
        if (( i == selected )); then
          printf '\e[7m> %s %s\e[0m\n' $mark "${branches[i]}"
        else
          printf '  %s %s\n' $mark "${branches[i]}"
        fi
      done

      read -sk key
      if [[ $key == $'\e' ]]; then
        rest=''
        read -sk2 -t 0.05 rest   # arrow keys arrive as \e[A / \eOA; a lone Esc times out
        key+=$rest
      fi

      case $key in
        $'\e[A'|$'\eOA'|k) selected=$(( selected > 1 ? selected - 1 : total )) ;;
        $'\e[B'|$'\eOB'|j) selected=$(( selected < total ? selected + 1 : 1 )) ;;
        $'\n'|$'\r')       break ;;
        q|Q|$'\e')         selected=0; break ;;
      esac
    done
  } always {
    printf '\e[?25h\e[?1049l'   # show cursor, restore screen
  }

  if (( selected == 0 )); then
    print "Cancelled"
    return 0
  fi
  git switch "${branches[selected]}"
}